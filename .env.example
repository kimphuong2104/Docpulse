# PostgreSQL
POSTGRES_USER=docpulse
POSTGRES_PASSWORD=docpulse_secret
POSTGRES_DB=docpulse_mvp
# Host port. Use another port when 5432 is already taken on the machine.
POSTGRES_PORT=5432
# Host port for the API. Use another port when 8000 is already taken.
API_PORT=8000
DATABASE_URL=postgresql://docpulse:docpulse_secret@db:5432/docpulse_mvp

# Embedding
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072

# LLM
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=

# API
MAX_UPLOAD_MB=25
